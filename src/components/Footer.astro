---
import { ui, type Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui[lang];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container row">
    <p>© {year} {s.name}. {s.footer.rights}</p>
    <ul>
      <li><a href={site.contact.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={site.contact.behance} target="_blank" rel="noopener">Behance</a></li>
      <li><a href="#top" data-top>{s.footer.top} ↑</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 2rem calc(2rem + env(safe-area-inset-bottom)); color: var(--muted); font-size: 0.9rem; }
  .row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; }
  a { transition: color 0.3s var(--ease); }
  a:hover { color: var(--accent); }
</style>

<script>
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0 });
  });
</script>
