---
import Img from './Img.astro';
import { ui, type Lang } from '../i18n/ui';
import { url, t, type Project } from '../lib/site';

interface Props { project: Project; lang: Lang; index: number }
const { project: p, lang, index } = Astro.props;
const s = ui[lang];
const title = t(p, 'title', lang);
---
<li class="card" data-category={p.category} data-reveal style={`--d:${(index % 2) * 0.08}s`}>
  <a href={url(`${lang}/work/${p.slug}/`)} aria-label={`${title} — ${s.work.view}`}>
    <div class="media">
      <Img src={p.cover} alt={title} sizes="(min-width: 860px) 50vw, 100vw" widths={[480, 720, 960, 1280]} />
      {p.todo && <span class="todo">TODO</span>}
    </div>
    <div class="meta">
      <div>
        <p class="cat">{s.categories[p.category]}</p>
        <h3>{title}</h3>
      </div>
      <span class="year">{p.year}</span>
    </div>
  </a>
</li>

<style>
  .card a { display: block; }
  .media { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--bg-2); }
  .media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.1s var(--ease), filter 0.8s var(--ease);
    filter: saturate(0.9) brightness(0.92);
  }
  .media::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line); pointer-events: none;
  }
  .todo {
    position: absolute; top: 0.9rem; inset-inline-start: 0.9rem;
    font: 600 0.7rem/1 var(--font-en); letter-spacing: 0.15em;
    background: var(--accent); color: var(--accent-ink); padding: 0.45rem 0.6rem; border-radius: 999px;
  }
  .meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding-top: 1.1rem; }
  .cat { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.25rem; }
  h3 { font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); font-weight: 500; line-height: 1.3; transition: color 0.4s var(--ease); }
  .year { color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; padding-top: 0.15rem; }
  @media (hover: hover) {
    .card a:hover .media :global(img) { transform: scale(1.045); filter: saturate(1.05) brightness(1); }
    .card a:hover h3 { color: var(--accent); }
  }
</style>
