---
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui[lang].about;
---
<section class="section about" id="about">
  <div class="container layout">
    <div class="section-head" data-reveal>
      <p class="kicker">{s.kicker}</p>
      <h2 class="h-section">{s.title}</h2>
    </div>

    <div class="body">
      <p class="lead" data-reveal>{s.p1}</p>
      <p data-reveal>{s.p2}</p>

      <div class="team" data-reveal>
        <h3>{s.teamTitle}</h3>
        <ul>{s.team.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>

    <div class="principles">
      <h3 class="visually-label" data-reveal>{s.principlesTitle}</h3>
      <ol>
        {s.principles.map(([title, text], i) => (
          <li data-reveal style={`--d:${i * 0.1}s`}>
            <span class="num">0{i + 1}</span>
            <h4>{title}</h4>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about { border-top: 1px solid var(--line); }
  .layout { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 960px) {
    .layout { grid-template-columns: 1fr 1fr; column-gap: 6vw; }
    .section-head { margin-bottom: 0; align-self: start; position: sticky; top: 7rem; }
    .principles { grid-column: 1 / -1; }
  }
  .body { display: grid; gap: 1.5rem; color: rgba(242, 239, 233, 0.8); }
  .lead { font-size: clamp(1.2rem, 1rem + 0.7vw, 1.55rem); line-height: 1.55; color: var(--text); }
  .team { margin-top: 1rem; }
  h3 { font-size: 0.85rem; color: var(--muted); font-weight: 500; margin-bottom: 1rem; letter-spacing: 0.08em; text-transform: uppercase; }
  :global(html[lang='ar']) h3 { letter-spacing: 0; font-size: 0.95rem; }
  .team ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .team li { border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 1rem; color: var(--text); font-size: 0.95rem; }
  .principles ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border-block: 1px solid var(--line); }
  @media (min-width: 760px) { .principles ol { grid-template-columns: repeat(3, 1fr); } }
  .principles li { background: var(--bg); padding: 2rem 0; display: grid; gap: 0.6rem; align-content: start; }
  @media (min-width: 760px) { .principles li { padding: 2.25rem 2rem 2.5rem; } .principles li:first-child { padding-inline-start: 0; } }
  .num { color: var(--accent); font-family: var(--font-en); font-size: 0.85rem; }
  h4 { margin: 0; font-size: 1.3rem; font-weight: 600; }
  .principles p { color: var(--muted); }
</style>
