---
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Img from '../../../components/Img.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import { languages, ui, type Lang } from '../../../i18n/ui';
import { projects, resolveImage, t, url, type Project } from '../../../lib/site';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    projects.map((project, i) => ({
      params: { lang, slug: project.slug },
      props: { project, next: projects[(i + 1) % projects.length] },
    })),
  );
}

interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;
const lang = Astro.params.lang as Lang;
const s = ui[lang];
const title = t(p, 'title', lang);
const description = t(p, 'description', lang);

// Social share image: a 1200×630 crop of the cover.
const coverImg = resolveImage(p.cover);
const ogImage = typeof coverImg === 'string'
  ? coverImg
  : (await getImage({ src: coverImg, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src;

const meta = [
  [s.project.client, p.client],
  [s.project.year, String(p.year)],
  [s.project.category, s.categories[p.category]],
  [s.project.role, t(p, 'role', lang)],
];
---
<Base lang={lang} title={title} description={description} ogImage={ogImage} ogType="article">
  <article>
    <header class="cover">
      <Img src={p.cover} alt={title} eager sizes="100vw" widths={[640, 960, 1280, 1920, 2400]} class="cover-img" />
      <div class="cover-shade" aria-hidden="true"></div>
      <div class="container cover-text">
        <a class="back" href={url(`${lang}/#work`)}>
          <svg class="flip-rtl" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m0 0 6-6m-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          {s.project.back}
        </a>
        <p class="kicker">{s.categories[p.category]} · {p.year}</p>
        <h1>{title}</h1>
        {p.todo && <p class="todo">TODO — placeholder project. Replace in src/data/projects.json</p>}
      </div>
    </header>

    <div class="container body">
      <dl class="meta" data-reveal>
        {meta.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
        {p.tools && p.tools.length > 0 && (
          <div class="tools">
            <dt>{s.project.tools}</dt>
            <dd><ul>{p.tools.map((tool) => <li dir="ltr">{tool}</li>)}</ul></dd>
          </div>
        )}
      </dl>

      <p class="desc" data-reveal>{description}</p>
    </div>

    {p.video && (
      <div class="container wide" data-reveal>
        <VideoPlayer video={p.video} poster={p.video_poster || p.cover} title={title} playLabel={s.project.play} />
      </div>
    )}

    {p.gallery && p.gallery.length > 0 && (
      <section class="container wide gallery" aria-label={s.project.gallery}>
        {p.gallery.map((g, i) => (
          <figure data-reveal>
            <Img src={g} alt={`${title} — ${i + 1}`} sizes="(min-width: 860px) 50vw, 100vw" widths={[480, 800, 1200, 1600]} />
          </figure>
        ))}
      </section>
    )}

    <section class="container end">
      <p class="cta" data-reveal>
        <a href={url(`${lang}/#contact`)}>{s.project.cta} <span class="flip-rtl" aria-hidden="true">→</span></a>
      </p>
      <a class="next" href={url(`${lang}/work/${next.slug}/`)} data-reveal>
        <span class="kicker">{s.project.next}</span>
        <span class="next-title">{t(next, 'title', lang)}</span>
        <div class="next-img"><Img src={next.cover} alt="" sizes="(min-width: 860px) 40vw, 100vw" widths={[480, 800, 1200]} /></div>
      </a>
    </section>
  </article>
</Base>

<style>
  .cover { position: relative; min-height: 88svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }
  .cover :global(.cover-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: coverIn 1.8s var(--ease) both; }
  @keyframes coverIn { from { transform: scale(1.08); opacity: 0.4; } to { transform: none; opacity: 1; } }
  .cover-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, var(--bg) 2%, rgba(11, 11, 12, 0.35) 55%, rgba(11, 11, 12, 0.5) 100%); }
  .cover-text { display: grid; gap: 1rem; padding-block: 7rem clamp(2.5rem, 6vw, 4.5rem); }
  .back { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--muted); width: fit-content; margin-bottom: 1rem; transition: color 0.3s var(--ease); }
  .back:hover { color: var(--accent); }
  .back svg { width: 1.2em; height: 1.2em; }
  h1 { font-size: clamp(2.4rem, 1.2rem + 6vw, 7rem); line-height: 1; letter-spacing: -0.04em; font-weight: 600; max-width: 16ch; }
  :global(html[lang='ar']) h1 { letter-spacing: 0; line-height: 1.25; font-weight: 700; }
  .todo { display: inline-block; width: fit-content; background: var(--accent); color: var(--accent-ink); font: 600 0.75rem/1.2 var(--font-en); padding: 0.45rem 0.8rem; border-radius: 999px; direction: ltr; }

  .body { display: grid; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(2.5rem, 6vw, 5rem); }
  @media (min-width: 960px) { .body { grid-template-columns: 1fr 1.4fr; align-items: start; } }
  .meta { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .meta > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  dt { color: var(--muted); font-size: 0.9rem; }
  dd { margin: 0; }
  .tools ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tools li { font-size: 0.85rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.75rem; }
  .desc { font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem); line-height: 1.5; }
  :global(html[lang='ar']) .desc { line-height: 1.8; }

  .wide { max-width: 1680px; }
  .gallery { display: grid; gap: clamp(0.75rem, 2vw, 1.5rem); padding-block: clamp(1rem, 3vw, 2rem); }
  @media (min-width: 860px) {
    .gallery { grid-template-columns: 1fr 1fr; }
    .gallery figure:first-child { grid-column: 1 / -1; }
  }
  figure { margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .end { padding-block: clamp(4rem, 10vw, 8rem); display: grid; gap: clamp(3rem, 8vw, 6rem); }
  .cta a { font-size: clamp(1.5rem, 1rem + 2.5vw, 3rem); line-height: 1.2; font-weight: 500; border-bottom: 1px solid var(--accent); transition: color 0.3s var(--ease); }
  .cta a:hover { color: var(--accent); }
  .cta span { display: inline-block; }
  .next { display: grid; gap: 1rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  @media (min-width: 860px) { .next { grid-template-columns: 1fr 1fr; align-items: end; } .next .kicker { grid-column: 1 / -1; } }
  .next-title { font-size: clamp(1.8rem, 1rem + 3.5vw, 4rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; transition: color 0.4s var(--ease); }
  :global(html[lang='ar']) .next-title { letter-spacing: 0; line-height: 1.35; }
  .next-img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9; }
  .next-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .next:hover .next-title { color: var(--accent); }
  .next:hover .next-img :global(img) { transform: scale(1.04); }
</style>
